<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Work Flow website: publish the board export the Claude sync task leaves in ~/.wf-board/x.
     Installed by tools/install-mac-publish.sh. Remove with: launchctl bootout gui/$(id -u)/com.wfboard.publish -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.wfboard.publish</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__HOME__/.wf-board/repo/tools/mac-publish.sh</string>
  </array>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/.wf-board/state/launchd.err</string>
</dict>
</plist>
